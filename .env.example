# Copy to .env and fill in. Everything here has a working default except the key.

# --- xAI ---------------------------------------------------------------------
# Without a key the system runs on the deterministic offline provider: the
# pipeline still completes, tests still pass, decisions are still recorded.
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# xai | stub | auto   ("auto" uses xAI when a key is present, else the stub)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0

# --- Agent loops -------------------------------------------------------------
MAX_EXTRACTION_ATTEMPTS=3
MAX_CRITIQUE_ROUNDS=2

# --- Approval policy ---------------------------------------------------------
HIGH_VALUE_THRESHOLD=10000
ARITHMETIC_TOLERANCE=0.01
BASE_CURRENCY=USD
POLICY_VERSION=2026.09.2
EXTRACTION_CONFIDENCE_THRESHOLD=0.90

# --- Document bounds ---------------------------------------------------------
MAX_UPLOAD_BYTES=10000000
MAX_PDF_PAGES=30
OCR_TIMEOUT_SECONDS=30
# Optional separate persistent location for uploaded originals.
# UPLOAD_DIR=/path/to/uploads

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
